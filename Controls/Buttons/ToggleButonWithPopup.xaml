<UserControl x:Class="ODEliteTracker.Controls.Buttons.ToggleButonWithPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ODEliteTracker.Controls.Buttons"
             mc:Ignorable="d"
             x:Name="Root"
             Width="100"
             Height="30"
             d:DesignHeight="30"
             d:DesignWidth="100">
    <Grid>
        <ToggleButton Name="ToggleBtn"
                      Width="{Binding ElementName=Root, Path=Width}"
                      Height="{Binding ElementName=Root, Path=Height}"
                      Content="{Binding ElementName=Root, Path=ToggleButtonContent}"
                      BorderThickness="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Style="{Binding ElementName=Root, Path=ButtonStyle}" />

        <Popup IsOpen="{Binding IsChecked, ElementName=ToggleBtn}"
               Closed="Popup_Closed"               
               x:Name="Popup"
               PlacementTarget="{Binding ElementName=ToggleBtn}"
               VerticalOffset="5"
               StaysOpen="False">
            <Border Background="{DynamicResource ViewBackground}"
                    BorderBrush="{DynamicResource PrimaryControlBorder}"
                    Padding="5"
                    ButtonBase.Click="Popup_Click"
                    BorderThickness="1">
                <ContentControl Content="{Binding ElementName=Root, Path=PopupContent}" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
