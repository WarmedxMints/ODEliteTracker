<UserControl x:Class="ODEliteTracker.Controls.Colonisation.ColoniationRoutePlannerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ODEliteTracker.Controls.Colonisation"
             xmlns:viewmodels="clr-namespace:ODEliteTracker.ViewModels"
             xmlns:galaxy="clr-namespace:ODEliteTracker.Controls.Galaxy"
             xmlns:popouts="clr-namespace:ODEliteTracker.ViewModels.PopOuts"
             xmlns:busyIndicator="https://github.com/moh3ngolshani/BusyIndicator"
             xmlns:controls="clr-namespace:ODEliteTracker.Controls.Buttons"
             xmlns:setting="clr-namespace:ODEliteTracker.Models.Settings"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:odmvvm="clr-namespace:ODMVVM.Helpers;assembly=ODMVVM"
             xmlns:models="clr-namespace:ODEliteTracker.Models"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance viewmodels:ColonisationRoutePlannerViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="1920">
    <UserControl.Resources>
        <ObjectDataProvider MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}"
                            x:Key="ColonisationRouteClipboardBehavior">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="setting:ColonisationRouteClipboardBehavior" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>      
    </UserControl.Resources>
    <Grid TextBlock.FontSize="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="450" />
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Left"
                    Orientation="Horizontal">
            <controls:ToggleButonWithPopup ToggleButtonContent="Import"
                                           Width="80"
                                           Height="30"
                                           x:Name="ImportPopup"
                                           BorderThickness="0"
                                           Margin="5,0">
                <controls:ToggleButonWithPopup.PopupContent>
                    <Menu Width="200"
                          FontSize="16"
                          Background="{DynamicResource ViewBackground}"
                          HorizontalAlignment="Left">
                        <MenuItem Header="Elite Game NavRoute"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Click="LoadGameNavRoute"
                                Style="{DynamicResource EliteBtnMenuStyle}" />
                        <MenuItem Header="Saved Elite NavRoute"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                Click="ImportSavedNavRoute"
                                HorizontalContentAlignment="Left"
                                  Style="{DynamicResource EliteBtnMenuStyle}" />
                        <MenuItem Header="Spansh Colonisation Json"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                Click="ImportSpanshJson"
                                HorizontalContentAlignment="Left"
                                  Style="{DynamicResource EliteBtnMenuStyle}" />
                        <MenuItem Header="Reload from Database"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Command="{Binding ReloadFromDatabaseCommand}"
                                  Style="{DynamicResource EliteBtnMenuStyle}" />
                        <MenuItem Header="Exported Route Json"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Click="LoadFromJsonSave"
                                  Style="{DynamicResource EliteBtnMenuStyle}" />
                        <MenuItem Header="Othe Commanders Route"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,2"
                                  Width="200"
                                  HorizontalContentAlignment="Stretch"
                                  ItemsSource="{Binding LiveCommanders}"
                                  Style="{DynamicResource EliteBtnMenuStyle}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="{x:Type MenuItem}"
                                       BasedOn="{StaticResource EliteBtnMenuStyle}">
                                    <Setter Property="Header"
                                            Value="{Binding Name}" />
                                    <Setter Property="Command"
                                            Value="{Binding ElementName=Root, Path=DataContext.ImportCommandersRouteCommand}" />
                                    <Setter Property="CommandParameter"
                                            Value="{Binding }" />
                                    <EventSetter Event="MenuItem.Click"
                                                 Handler="ImportSubMenuClicked" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </Menu>
                </controls:ToggleButonWithPopup.PopupContent>
            </controls:ToggleButonWithPopup>

            <controls:ToggleButonWithPopup ToggleButtonContent="Export"
                                           Width="80"
                                           Height="30"
                                           Margin="5,0">
                <controls:ToggleButonWithPopup.PopupContent>
                    <StackPanel>
                        <Button Content="To Json"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Click="SaveJson"
                                Style="{DynamicResource PopOutBtn}" />
                        <Button Content="To CSV"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Click="SaveCsv"
                                Style="{DynamicResource PopOutBtn}" />
                    </StackPanel>
                </controls:ToggleButonWithPopup.PopupContent>
            </controls:ToggleButonWithPopup>

            <controls:ToggleButonWithPopup ToggleButtonContent="Current System"
                                           Width="130"
                                           Height="30"
                                           BorderThickness="0"
                                           Margin="5,0">
                <controls:ToggleButonWithPopup.PopupContent>
                    <StackPanel>
                        <Button Content="Add to Start of Route"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Command="{Binding AddCurrentSystemToRouteCommand}"
                                CommandParameter="{x:Static viewmodels:AddSystemToRouteEnum.AtStart}"
                                Style="{DynamicResource PopOutBtn}" />
                        <Button Content="Add Before Selected System"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Command="{Binding AddCurrentSystemToRouteCommand}"
                                CommandParameter="{x:Static viewmodels:AddSystemToRouteEnum.BeforeSelected}"
                                Style="{DynamicResource PopOutBtn}" />
                        <Button Content="Add After Selected System"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Command="{Binding AddCurrentSystemToRouteCommand}"
                                CommandParameter="{x:Static viewmodels:AddSystemToRouteEnum.AfterSelected}"
                                Style="{DynamicResource PopOutBtn}" />
                        <Button Content="Add to End of Route"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Command="{Binding AddCurrentSystemToRouteCommand}"
                                CommandParameter="{x:Static viewmodels:AddSystemToRouteEnum.AtEnd}"
                                Style="{DynamicResource PopOutBtn}" />
                        <Button Content="Select in Route"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Command="{Binding SelectCurrentSystemCommand}"
                                Style="{DynamicResource PopOutBtn}" />
                    </StackPanel>
                </controls:ToggleButonWithPopup.PopupContent>
            </controls:ToggleButonWithPopup>

            <Button Content="Remove All After Selected"
                    Width="210"
                    Height="30"
                    Margin="5,0"
                    Command="{Binding RemoveAfterSelectedCommand}"
                    Style="{DynamicResource EliteStyleButton}" />

            <controls:ToggleButonWithPopup ToggleButtonContent="Select System"
                                           CloseOnClick="False"
                                           x:Name="SelectSystemPopup"
                                           Width="130"
                                           Height="30"
                                           Margin="5,0">
                <controls:ToggleButonWithPopup.PopupContent>
                    <StackPanel>
                        <Button Content="First System"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Click="SelectStartOfRoute"
                                Style="{DynamicResource PopOutBtn}" />
                        <Button Content="Last Built system"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Click="SelectLastBuilt"
                                Style="{DynamicResource PopOutBtn}" />
                        <Button Content="Last Built Hub"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Click="SelectLastBuiltHub"
                                Style="{DynamicResource PopOutBtn}" />
                        <Button Content="Next System With Notes"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Click="SelectNextSystemWithNotes"
                                Style="{DynamicResource PopOutBtn}" />
                        <Button Content="First Marked as not built"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Click="SelectFirstNotBuilt"
                                Style="{DynamicResource PopOutBtn}" />
                        <Button Content="Last System"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Click="SelectLastSystem"
                                Style="{DynamicResource PopOutBtn}" />
                    </StackPanel> 
                </controls:ToggleButonWithPopup.PopupContent>
            </controls:ToggleButonWithPopup>

            <controls:ToggleButonWithPopup ToggleButtonContent="Open Web Page"
                                           CloseOnClick="True"
                                           Width="130"
                                           Height="30"
                                           Margin="5,0">
                <controls:ToggleButonWithPopup.PopupContent>
                    <StackPanel>
                        <Button Content="Inara"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Command="{Binding OpenSystemWebPageCommand}"
                                CommandParameter="{x:Static models:SystemWebSite.Inara}"
                                Style="{DynamicResource PopOutBtn}" />
                        <Button Content="Spansh"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Command="{Binding OpenSystemWebPageCommand}"
                                CommandParameter="{x:Static models:SystemWebSite.Spansh}"
                                Style="{DynamicResource PopOutBtn}" />
                        <Button Content="Raven Colonial"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                Command="{Binding OpenSystemWebPageCommand}"
                                CommandParameter="{x:Static models:SystemWebSite.RavenColonial}"
                                Style="{DynamicResource PopOutBtn}" />
                    </StackPanel>
                </controls:ToggleButonWithPopup.PopupContent>
            </controls:ToggleButonWithPopup>            
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    Grid.Column="1"
                    HorizontalAlignment="Right">
            <Button Content="Save"
                    Width="50"
                    Height="30"
                    Margin="5,0"
                    Command="{Binding SaveRouteCommand}"
                    Style="{DynamicResource EliteStyleButton}" />

            <controls:ToggleButonWithPopup  Width="30"
                                            Height="30"
                                            Margin="5,0"
                                            ButtonStyle="{DynamicResource EliteSytleImageToggleBtn}"
                                            CloseOnClick="False">
                <controls:ToggleButonWithPopup.ToggleButtonContent>
                    <Image Source="/Assets/Icons/settings.png"
                           Margin="2" />
                </controls:ToggleButonWithPopup.ToggleButtonContent>
                <controls:ToggleButonWithPopup.PopupContent>

                    <Grid Width="570">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                        </Grid.RowDefinitions>

                        <CheckBox Style="{DynamicResource EliteStyleCheckBox}"
                                  IsChecked="{Binding AutoSelect}"
                                  Margin="10,0"
                                  Content="Auto Select System"
                                  VerticalAlignment="Center"
                                  Grid.Row="0" />
                        <TextBlock Text="Select System In Route When Arriving"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Grid.Column="1"
                                   Grid.Row="0"
                                   FontSize="16" />

                        <Button Content="Recheck Systems"
                                Click="CheckBodyCounts"
                                Height="35"
                                Width="150"
                                Margin="10,0"
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{DynamicResource EliteStyleButton}" />
                        <TextBlock Text="Rechecks system body counts and built status from your logs (will also check spansh if enabled)"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   FontSize="16" />

                        <CheckBox Style="{DynamicResource EliteStyleCheckBox}"
                                  Margin="10,0"
                                  IsChecked="{Binding UseSpansh}"
                                  Content="Check Spansh"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Grid.Row="2" />
                        <TextBlock Text="Set if Spansh will be used to check system body counts and built status if they aren't found in your logs"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Grid.Column="1"
                                   Grid.Row="2"
                                   FontSize="16" />

                        <ComboBox ItemsSource="{Binding Source={StaticResource ColonisationRouteClipboardBehavior}}"
                                  SelectedItem="{Binding RouteClipboardBehavior}"
                                  Height="30"
                                  VerticalAlignment="Center"
                                  Margin="10,0"
                                  Grid.Row="3">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding ClipboardBehaviourText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Grid.Column="1"
                                   Grid.Row="3"
                                   FontSize="16" />
                        
                        <Button Content="Clear Route"
                                Height="35"
                                Width="150"
                                Margin="10,0"
                                Click="ClearRoute"
                                Grid.Row="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{DynamicResource EliteStyleButton}" />
                        <TextBlock Text="Clears the route list"
                                   VerticalAlignment="Center"
                                   Grid.Column="1"
                                   Grid.Row="4"
                                   FontSize="16" />                       
                    </Grid>
                </controls:ToggleButonWithPopup.PopupContent>
            </controls:ToggleButonWithPopup>
        </StackPanel>
        <busyIndicator:BusyMask x:Name="BusyIndicator"
                                IsBusy="{Binding IsBusy}"
                                Background="{DynamicResource CardBackground}"
                                FontSize="30"
                                Height="Auto"
                                Grid.Row="1"
                                BusyContent="Loading Systems From Database"
                                IndicatorType="Cupertino"
                                BusyContentMargin="0,20,0,0">
            <DataGrid x:Name="RouteListGrid"
                      ItemsSource="{Binding RouteSystems}"
                      AutoGenerateColumns="False"
                      SelectedItem="{Binding SelectedSystem}"
                      Style="{DynamicResource BaseDataGridStyle}"
                      FontSize="18"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      HorizontalAlignment="Left"
                      AlternatingRowBackground="{DynamicResource RowAlternationColour}"
                      Grid.Row="1">
                <DataGrid.Resources>
                    <odmvvm:WpfBindingProxy x:Key="proxy"
                                            Data="{Binding }" />

                    <ContextMenu  x:Key="RowMenu"
                                  HasDropShadow="False"
                                  TextBlock.FontSize="16"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Copy to Clipboard"
                                  Command="{Binding Data.SetClipboardCommand, Source={StaticResource proxy}}"
                                  CommandParameter="{Binding SystemName}"
                                  Style="{DynamicResource EliteContextMenuItemStyle}" />
                        <MenuItem Header="Toggle Hub"
                                  Command="{Binding Data.ToggleSelectedHubCommand, Source={StaticResource proxy}}"
                                  Style="{DynamicResource EliteContextMenuItemStyle}" />
                        <MenuItem Header="Toggle Built"
                                  Command="{Binding Data.ToggleSelectedBuiltCommand, Source={StaticResource proxy}}"
                                  Style="{DynamicResource EliteContextMenuItemStyle}" />
                        <MenuItem Header="Set As Target"
                                  Command="{Binding Data.SetSelctedAsTargetCommand, Source={StaticResource proxy}}"
                                  Style="{DynamicResource EliteContextMenuItemStyle}" />
                        <Separator Style="{DynamicResource EliteSeparatorStyle}"/>
                        <MenuItem Header="Open on Inara"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                  Command="{Binding Data.OpenSystemWebPageCommand, Source={StaticResource proxy}}"
                                CommandParameter="{x:Static models:SystemWebSite.Inara}"
                                  Style="{DynamicResource EliteContextMenuItemStyle}" />
                        <MenuItem Header="Open on Spansh"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                  Command="{Binding Data.OpenSystemWebPageCommand, Source={StaticResource proxy}}"
                                CommandParameter="{x:Static models:SystemWebSite.Spansh}"
                                  Style="{DynamicResource EliteContextMenuItemStyle}" />
                        <MenuItem Header="Open on Raven Colonial"
                                HorizontalAlignment="Stretch"
                                Margin="0,2"
                                HorizontalContentAlignment="Left"
                                  Command="{Binding Data.OpenSystemWebPageCommand, Source={StaticResource proxy}}"
                                CommandParameter="{x:Static models:SystemWebSite.RavenColonial}"
                                  Style="{DynamicResource EliteContextMenuItemStyle}" />
                        <Separator Style="{DynamicResource EliteSeparatorStyle}" />
                        <MenuItem Header="Delete System"
                                  Click="DeleteSelectedSystem"
                                  Style="{DynamicResource EliteContextMenuItemStyle}" />
                    </ContextMenu>
                    <Style TargetType="{x:Type DataGridRow}"
                           BasedOn="{StaticResource CommanderRowStyle}">
                        <Setter Property="ContextMenu"
                                Value="{StaticResource RowMenu}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hop"
                                        Width="50"
                                        HeaderStyle="{DynamicResource DataGridHeaderCenter}"
                                        CellStyle="{DynamicResource CmdrSelectionCellLeft}"
                                        Binding="{Binding HopNumber}" />
                    <DataGridTextColumn Header="System Name"
                                        Width="*"
                                        HeaderStyle="{DynamicResource DataGridHeaderLeft}"
                                        CellStyle="{DynamicResource CmdrSelectionCellLeft}"
                                        Binding="{Binding SystemName}" />
                    <DataGridTextColumn Header="Bodies"
                                        Width="60"
                                        HeaderStyle="{DynamicResource DataGridHeaderCenter}"
                                        CellStyle="{DynamicResource CmdrSelectionCellCenter}"
                                        Binding="{Binding BodyCountString}" />
                    <DataGridTextColumn Header="Stars"
                                        Width="60"
                                        HeaderStyle="{DynamicResource DataGridHeaderCenter}"
                                        CellStyle="{DynamicResource CmdrSelectionCellCenter}"
                                        Binding="{Binding StarCountString}" />
                    <DataGridTemplateColumn  HeaderStyle="{DynamicResource DataGridHeaderLeft}"
                                             CellStyle="{DynamicResource CmdrSelectionCellCenter}"
                                             Header=" ">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Rectangle Opacity="1"
                                           Height="18"
                                           Width="18"
                                           Fill="White"
                                           Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>
                                                <Viewbox Stretch="Uniform">
                                                    <Image Source="/Assets/Icons/write-file.png" />
                                                </Viewbox>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  HeaderStyle="{DynamicResource DataGridHeaderLeft}"
                                             CellStyle="{DynamicResource CmdrSelectionCellCenter}"
                                             Header=" ">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Rectangle Opacity="1"
                                           Height="18"
                                           Width="18"
                                           Fill="ForestGreen"
                                           Visibility="{Binding Hub, Converter={StaticResource BoolToVis}}">
                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>
                                                <Viewbox Stretch="Uniform">
                                                    <Image Source="/Assets/Icons/cooling-tower.png" />
                                                </Viewbox>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  HeaderStyle="{DynamicResource DataGridHeaderLeft}"
                                             CellStyle="{DynamicResource CmdrSelectionCellCenter}"
                                             Header=" ">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Visibility="{Binding Built, Converter={StaticResource BoolToVis}}"
                                           Foreground="ForestGreen"
                                           FontWeight="ExtraBold"
                                           Text="&#xE73E;" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Hop Dist"
                                        Width="110"
                                        HeaderStyle="{DynamicResource DataGridHeaderCenter}"
                                        ElementStyle="{StaticResource DataGridElementRightMargin}"
                                        Binding="{Binding Distance, StringFormat={}{0:N2} ly}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource EliteBtnBGMouseOver}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource EliteBtnFGMouseOver}" />
                                        <Setter Property="BorderBrush"
                                                Value="Transparent" />
                                        <Setter Property="BorderThickness"
                                                Value="0" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding GreaterThan15ly}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="Red" />
                                        <Setter Property="FontWeight"
                                                Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Total Hop Dist"
                                        Width="110"
                                        HeaderStyle="{DynamicResource DataGridHeaderCenter}"
                                        CellStyle="{DynamicResource CmdrSelectionCellRight}"
                                        Binding="{Binding TotalHopDistance, StringFormat={}{0:N2} ly}" />
                    <DataGridTextColumn Header="From Hub"
                                        Width="110"
                                        HeaderStyle="{DynamicResource DataGridHeaderCenter}"
                                        CellStyle="{DynamicResource CmdrSelectionCellRight}"
                                        Binding="{Binding TotalDistance, StringFormat={}{0:N2} ly}" />
                    <DataGridTextColumn Header="From Start"
                                        Width="110"
                                        HeaderStyle="{DynamicResource DataGridHeaderCenter}"
                                        CellStyle="{DynamicResource CmdrSelectionCellRight}"
                                        Binding="{Binding TotalDistanceFromStart, StringFormat={}{0:N2} ly}" />
                </DataGrid.Columns>
            </DataGrid>
        </busyIndicator:BusyMask>
        <TextBlock Text="{Binding TargetSystemText}"
                   Foreground="{DynamicResource Header}"
                   VerticalAlignment="Center"
                   Margin="10 0"
                   Grid.Row="3" />

        <TabControl Grid.Column="1"
                    Grid.Row="1"
                    Padding="0"
                    Grid.RowSpan="2">
            <TabItem Header="Selected System">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Grid.Row="0"
                              Visibility="{Binding SelectedSystem, Converter={StaticResource NullToVis}, ConverterParameter=Hidden}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{DynamicResource ClipboardBtn}"
                                        Command="{Binding SetClipboardCommand}"
                                        CommandParameter="{Binding SelectedSystem.SystemName}"
                                        Margin="5,0"
                                        Height="25"
                                        Width="25">
                                    <Image Source="/Assets/Icons/Clipboard.png"
                                           Margin="3" />
                                </Button>
                                <TextBlock Text="{Binding SelectedSystem.SystemName}"
                                           FontSize="24"
                                           Margin="0 10"
                                           Foreground="{DynamicResource Header}" />
                            </StackPanel>

                            <Button Content="Recheck"
                                    ToolTip="Recheck Body Counts"
                                    HorizontalAlignment="Right"
                                    Click="RecheckSelectBodyCount"
                                    Margin="5"
                                    Height="30"
                                    Style="{DynamicResource EliteStyleButton}" />
                            <galaxy:PositionControl Position="{Binding SelectedSystem.Position.Position}"
                                                    HorizontalAlignment="Center"
                                                    Grid.Row="1" />

                            <TextBlock Text="Notes"
                                       Grid.Row="2"
                                       FontSize="18"
                                       Margin="10 5 10 0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Left"
                                       Foreground="{DynamicResource Header}" />

                            <TextBox Text="{Binding SelectedSystem.Notes}"
                                     Grid.Row="3"
                                     Margin="10"
                                     Width="400"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Style="{DynamicResource EliteTextBox}"
                                     Foreground="{DynamicResource PrimaryControlForeground}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" />

                            <TextBlock Text="{Binding SelectedSystem.DistanceFromLineText}"
                                       Grid.Row="4"
                                       FontSize="17"
                                       TextWrapping="Wrap"
                                       Margin="10 5 10 0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Left" />
                        </Grid>
                    </ScrollViewer>
                    <Grid Grid.Column="1"
                          Grid.Row="1"
                          Visibility="{Binding SelectedSystem, Converter={StaticResource NullToVis}, ConverterParameter=Hidden}">

                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Hub"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedSystem.Hub, Mode=OneWay}"
                                      Command="{Binding ToggleSelectedHubCommand}"
                                      Style="{DynamicResource EliteStyleCheckBox}"
                                      Margin="5" />

                            <CheckBox Content="Built"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedSystem.Built, Mode=OneWay}"
                                      Command="{Binding ToggleSelectedBuiltCommand}"
                                      Style="{DynamicResource EliteStyleCheckBox}"
                                      Margin="5" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Set As Target"
                                    Style="{DynamicResource EliteStyleButton}"
                                    Command="{Binding SetSelctedAsTargetCommand}"
                                    Margin="5"
                                    Width="120"
                                    Height="30"
                                    HorizontalAlignment="Right" />
                            <Button Content="Delete"
                                    Style="{DynamicResource EliteStyleButton}"
                                    Click="DeleteSelectedSystem"
                                    Margin="5"
                                    Width="80"
                                    Height="30"
                                    HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Straight Line Tool">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Start Position"
                                   Margin="5 10"
                                   Grid.Row="0"
                                   Foreground="{DynamicResource Header}"
                                   VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="0"
                                    HorizontalAlignment="Right">
                            <controls:ToggleButonWithPopup ToggleButtonContent="Set"
                                                           HorizontalAlignment="Right"
                                                           Width="80"
                                                           Height="25">
                                <controls:ToggleButonWithPopup.PopupContent>
                                    <StackPanel>
                                        <Button Content="Use Selected System"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,2"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding SetStartAsSelectedCommand}"
                                                Style="{DynamicResource PopOutBtn}" />
                                        <Button Content="Use Current System"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,2"
                                                HorizontalContentAlignment="Left"
                                                Style="{DynamicResource PopOutBtn}"
                                                Command="{Binding SetStartAsCurrentCommand}" />
                                    </StackPanel>
                                </controls:ToggleButonWithPopup.PopupContent>
                            </controls:ToggleButonWithPopup>

                            <Button Command="{Binding OpenPopOut}"
                                    CommandParameter="{x:Type popouts:StraightLineToolPopOut}"
                                    Style="{DynamicResource EliteStyleImageButton}"
                                    Width="25"
                                    Height="25"
                                    Margin="5,0"
                                    Padding="2"
                                    ToolTip="Open Overlay">
                                <Image Source="/Assets/Icons/PopOutBtn.png" />
                            </Button>

                        </StackPanel>


                        <galaxy:PositionControl Position="{Binding StartPos}"
                                                Grid.Row="1" />

                        <TextBlock Text="End Position"
                                   Margin="5 10"
                                   Foreground="{DynamicResource Header}"
                                   VerticalAlignment="Center"
                                   Grid.Row="2" />

                        <controls:ToggleButonWithPopup ToggleButtonContent="Set"
                                                       HorizontalAlignment="Right"
                                                       Width="80"
                                                       Margin="0 0 35 0"
                                                       Grid.Row="2"
                                                       Height="25">
                            <controls:ToggleButonWithPopup.PopupContent>
                                <StackPanel>
                                    <Button Content="Use Target System"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SetEndAsTargetCommand}"
                                            Style="{DynamicResource PopOutBtn}" />
                                    <Button Content="Use Selected System"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SetEndAsSelectedCommand}"
                                            Style="{DynamicResource PopOutBtn}" />
                                    <Button Content="Use Current System"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SetEndAsCurrentCommand}"
                                            Style="{DynamicResource PopOutBtn}" />
                                </StackPanel>
                            </controls:ToggleButonWithPopup.PopupContent>
                        </controls:ToggleButonWithPopup>

                        <galaxy:PositionControl Position="{Binding EndPos}"
                                                Grid.Row="3" />

                        <Grid Grid.Row="5"
                              TextBlock.FontSize="20"
                              Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Current distance from start position"
                                       Foreground="{DynamicResource Header}"
                                       VerticalAlignment="Center"
                                       Margin="0 5"
                                       Grid.Row="0" />
                            <TextBlock Text="{Binding DistanceFromStart}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Grid.Row="1"
                                       Margin="0 5"
                                       Grid.Column="1" />

                            <TextBlock Text="Current distance from 500ly point "
                                       Foreground="{DynamicResource Header}"
                                       VerticalAlignment="Center"
                                       Margin="0 5"
                                       Grid.Row="2" />
                            <TextBlock Text="{Binding DistanceFrom500ly}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Grid.Row="3"
                                       Margin="0 5"
                                       Grid.Column="1" />

                            <TextBlock Text="Current distance from straight line"
                                       Foreground="{DynamicResource Header}"
                                       VerticalAlignment="Center"
                                       Margin="0 5"
                                       Grid.Row="4" />
                            <TextBlock Text="{Binding DistanceFromStraightLine}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Grid.Row="5"
                                       Margin="0 5"
                                       Grid.Column="1" />

                            <TextBlock Text="Directions to closest point on line"
                                       Foreground="{DynamicResource Header}"
                                       VerticalAlignment="Center"
                                       Margin="0 5"
                                       Grid.Row="6" />
                            <TextBlock Text="{Binding DirectionsToStraightLine}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Grid.Row="7"
                                       Margin="0 5"
                                       Grid.Column="1" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
