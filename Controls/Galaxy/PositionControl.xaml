<UserControl x:Class="ODEliteTracker.Controls.Galaxy.PositionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ODEliteTracker.Controls.Galaxy"
             mc:Ignorable="d" 
             x:Name="Root"
             HorizontalAlignment="Center"
             d:DesignHeight="50" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="{x:Type Border}">
            <Setter Property="BorderBrush"
                    Value="{DynamicResource PrimaryControlBorder}" />
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryControlBackground}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=Root, Path=InOverlay}"
                             Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource Overlay_BorderBrush}" />
                    <Setter Property="Background"
                            Value="{DynamicResource Overlay_CardBackground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryControlForeground}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=Root, Path=InOverlay}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource Overlay_ForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" >
        <TextBlock Text="X"
                   FontSize="18"
                   Margin="5, 0"
                   VerticalAlignment="Center"
                   TextAlignment="Center"/>

        <Border BorderThickness="1"
                Margin="5, 0"
                Width="100" >
            <TextBlock Text="{Binding ElementName=Root, Path=Position.X, StringFormat={}{0:N2}, Mode=OneWay}"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <TextBlock Text="Y"
                   FontSize="18"
                   Margin="5, 0"
                   VerticalAlignment="Center"
                   TextAlignment="Center" />

        <Border BorderThickness="1"
                Margin="5, 0"
                Width="100">
            <TextBlock Text="{Binding ElementName=Root, Path=Position.Y, StringFormat={}{0:N2}, Mode=OneWay}"
                       VerticalAlignment="Center"
                       TextAlignment="Center" />
        </Border>

        <TextBlock Text="Z"
                   FontSize="18"
                   Margin="5, 0"
                   VerticalAlignment="Center"
                   TextAlignment="Center" />

        <Border BorderThickness="1"
                Margin="5, 0"
                Width="100">
            <TextBlock Text="{Binding ElementName=Root, Path=Position.Z, StringFormat={}{0:N2}, Mode=OneWay}"
                       VerticalAlignment="Center"
                       TextAlignment="Center" />
        </Border>
    </StackPanel>
</UserControl>
