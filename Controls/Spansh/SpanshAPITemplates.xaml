                     Grid.Row="1"
                     Margin="10"
                     Height="30" />

            <TextBlock Text="Target System"
                       Grid.Row="2"
                       Margin="0 2"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <TextBox Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}"
                     DataContext="{Binding CurrentApiArgs.TargetSystem}"
                     Grid.Row="3"
                     Margin="10"
                     Height="30"
                     Style="{DynamicResource ApiSystemNameTextBox}" />
            <!--#endregion-->

            <!--#region Coloumn 3-->
            <Button Content="Current System"
                    Grid.Column="3"
                    Grid.Row="1"
                    Height="30"
                    Width="200"
                    HorizontalAlignment="Left"
                    Command="{Binding SetCurrentSystemCommand}"
                    Style="{DynamicResource EliteStyleButton}" />

            <Button Content="Last Game Route System"
                    Grid.Column="3"
                    Grid.Row="3"
                    Height="30"
                    Width="200"
                    HorizontalAlignment="Left"
                    Command="{Binding SetLastGameSystemAsTargetCommand}"
                    Style="{DynamicResource EliteStyleButton}" />
            <!--#endregion-->
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FleetCarrierRouteAPIControl">
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=DataContext}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="{StaticResource RightColumn}" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!--#region Coloumn 1-->
            <TextBlock Text="Source System"
                       Grid.Row="0"
                       Margin="0 2"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <TextBox Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}"
                     DataContext="{Binding CurrentApiArgs.SourceSystem}"
                     Style="{DynamicResource ApiSystemNameTextBox}"
                     Grid.Row="1"
                     Margin="10"
                     Height="30" />

            <TextBlock Text="Destination"
                       Grid.Row="2"
                       Margin="0 2"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <TextBox Grid.Row="3"
                     Margin="10"
                     Height="30"
                     x:Name="DestinationToAddTextBox"
                     Loaded="TextBoxLoaded"
                     Unloaded="TextBoxUnloaded"
                     Style="{DynamicResource ApiSystemTextBox}" />

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Used Capacity"
                           Grid.Row="0"
                           Margin="0 2"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Header}"
                           FontSize="14" />

                <textbox:NumberInputTextBox Grid.Row="1"
                                            Margin="10"
                                            Height="30"
                                            Width="120"
                                            HorizontalAlignment="Center"
                                            TextBlock.TextAlignment="Right"
                                            HorizontalContentAlignment="Right"
                                            AllowDecimals="False"
                                            DataContext="{Binding CurrentApiArgs}"
                                            Text="{Binding CapicityUsed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{DynamicResource ApiSystemTextBox}" />

                <TextBlock Text="Carrier Type"
                           Grid.Row="0"
                           Grid.Column="1"
                           Margin="0 2"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Header}"
                           FontSize="14" />

                <buttons:SwitchToggleButton HorizontalAlignment="Center"
                                            Margin="15 0"
                                            VerticalAlignment="Center"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            OffText="Personal"
                                            Command="{Binding ChangeCarrierTypeCommand}"
                                            IsChecked="{Binding SquadCarrier, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                            OnText="Squadron" />
            </Grid>

            <CheckBox Style="{DynamicResource EliteStyleCheckBox}"
                      Grid.Row="5"
                      Margin="10"
                      Content="Determine Tritium Requirements"
                      VerticalContentAlignment="Center"
                      VerticalAlignment="Center"
                      DataContext="{Binding CurrentApiArgs}"
                      IsChecked="{Binding DetermineTritRequirements}" />

            <TextBlock Text="Tritium in tank"
                       Grid.Row="6"
                       Margin="10 0"
                       DataContext="{Binding CurrentApiArgs}"
                       Visibility="{Binding DetermineTritRequirements, Converter={StaticResource InvertibleBoolToVis}, ConverterParameter=Inverted}"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <textbox:NumberInputTextBox Grid.Row="7"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        Width="120"
                                        Margin="10 5"
                                        AllowDecimals="False"
                                        TextBlock.TextAlignment="Right"
                                        DataContext="{Binding CurrentApiArgs}"
                                        Visibility="{Binding DetermineTritRequirements, Converter={StaticResource InvertibleBoolToVis}, ConverterParameter=Inverted}"
                                        Value="{Binding CurrentFuel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalContentAlignment="Right"
                                        Style="{DynamicResource ApiSystemTextBox}" />

            <TextBlock Text="Tritium in market"
                       Grid.Row="8"
                       Margin="10 0"
                       DataContext="{Binding CurrentApiArgs}"
                       Visibility="{Binding DetermineTritRequirements, Converter={StaticResource InvertibleBoolToVis}, ConverterParameter=Inverted}"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <textbox:NumberInputTextBox Grid.Row="9"
                                        Height="30"
                                        Margin="10 5"
                                        HorizontalAlignment="Left"
                                        Width="120"
                                        AllowDecimals="False"
                                        TextBlock.TextAlignment="Right"
                                        DataContext="{Binding CurrentApiArgs}"
                                        Visibility="{Binding DetermineTritRequirements, Converter={StaticResource InvertibleBoolToVis}, ConverterParameter=Inverted}"
                                        Value="{Binding TritInMarket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalContentAlignment="Right"
                                        Style="{DynamicResource ApiSystemTextBox}" />
            <!--#endregion-->

            <!--#region Coloumn 3-->
            <Button Content="Carrier Location"
                    Grid.Column="3"
                    Grid.Row="1"
                    Height="30"
                    Width="200"
                    HorizontalAlignment="Left"
                    Command="{Binding SetCurrentSystemCommand}"
                    Style="{DynamicResource EliteStyleButton}" />

            <Button Content="Add Destination"
                    Grid.Column="3"
                    Grid.Row="3"
                    Height="30"
                    Width="200"
                    HorizontalAlignment="Left"
                    Command="{Binding AddAdditionalSystemCommand}"
                    CommandParameter="{Binding ElementName=DestinationToAddTextBox, Path=Text}"
                    Style="{DynamicResource EliteStyleButton}" />


            <TextBlock Text="Destinations"
                       Grid.Row="4"
                       Grid.Column="3"
                       VerticalAlignment="Top"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <DataGrid Grid.Column="3"
                      Grid.Row="4"
                      Grid.RowSpan="8"
                      Margin="0 25 0 0"
                      Height="240"
                      Background="Transparent"
                      VerticalAlignment="Top"
                      Style="{DynamicResource SpanshDataGrid}"
                      RowHeight="25"
                      MaxWidth="230"
                      HeadersVisibility="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      RowStyle="{DynamicResource SpanshApiRowStyle}"
                      FontSize="16"
                      BorderBrush="{DynamicResource PrimaryControlBorder}"
                      BorderThickness="1"
                      PreviewMouseDown="DataGridMouseDown"
                      ItemsSource="{Binding CurrentApiArgs.AdditionalSystems}"
                      SelectedItem="{Binding CurrentApiArgs.SelectedAdditional}">
                <DataGrid.Resources>
                    <odmvvm:WpfBindingProxy x:Key="proxy"
                                            Data="{Binding }" />
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding SystemName}"
                                        Width="*"
                                        CellStyle="{DynamicResource CmdrSelectionCellLeftVertCenter}" />
                    <DataGridTemplateColumn CellStyle="{DynamicResource ButtonGridCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X"
                                        Margin="2"
                                        Command="{Binding Data.DeleteAdditionalSystemCommand, Source={StaticResource proxy}}"
                                        CommandParameter="{Binding }"
                                        Style="{DynamicResource EliteStyleButton}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <!--#endregion-->
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="GalaxyPlotterAPIControl">
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=DataContext}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="{StaticResource RightColumn}" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!--#region Coloumn 1-->
            <TextBlock Text="Source System"
