                           Margin="0 2"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Header}"
                           FontSize="14" />

                <textbox:NumberInputTextBox Grid.Row="1"
                                            Margin="10"
                                            Height="30"
                                            HorizontalAlignment="Center"
                                            Width="150"
                                            AllowDecimals="False"
                                            TextBlock.TextAlignment="Right"
                                            DataContext="{Binding CurrentApiArgs}"
                                            Value="{Binding StartingCapital, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            HorizontalContentAlignment="Right"
                                            Style="{DynamicResource ApiSystemTextBox}" />

                <TextBlock Text="Max Hop Distance (LY)"
                           Grid.Row="0"
                           Grid.Column="1"
                           Margin="0 2"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Header}"
                           FontSize="14" />

                <textbox:NumberInputTextBox Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="10"
                                            Height="30"
                                            HorizontalAlignment="Center"
                                            Width="100"
                                            AllowDecimals="True"
                                            TextBlock.TextAlignment="Right"
                                            DataContext="{Binding CurrentApiArgs}"
                                            Value="{Binding MaxHopDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            HorizontalContentAlignment="Right"
                                            Style="{DynamicResource ApiSystemTextBox}" />

                <TextBlock Text="Max Cargo Capcity"
                           Grid.Row="0"
                           Grid.Column="2"
                           Margin="0 2"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Header}"
                           FontSize="14" />

                <textbox:NumberInputTextBox Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="10"
                                            Height="30"
                                            HorizontalAlignment="Center"
                                            Width="100"
                                            AllowDecimals="False"
                                            TextBlock.TextAlignment="Right"
                                            DataContext="{Binding CurrentApiArgs}"
                                            Value="{Binding MaxCargo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            HorizontalContentAlignment="Right"
                                            Style="{DynamicResource ApiSystemTextBox}" />
            </Grid>

            <TextBlock Text="Max Distance to Arrival (ls)"
                       Grid.Row="5"
                       Margin="0 2"
                       HorizontalAlignment="Left"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <slilders:ExponetialSliderWithTextBox Grid.Row="6"
                                                  Margin="0 5"
                                                  TextBoxWidth="130"
                                                  Minimum="0"
                                                  MidPoint="20000"
                                                  Maximum="500000"
                                                  DataContext="{Binding CurrentApiArgs}"
                                                  Value="{Binding MaxSystemDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SliderWidth="320"/>

            <TextBlock Text="Max Hops"
                       Grid.Row="7"
                       Margin="0 2"
                       HorizontalAlignment="Left"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <StackPanel Orientation="Horizontal"
                        Margin="0 5"
                        Grid.Row="8">
                <textbox:NumberInputTextBox Height="30"
                                            HorizontalAlignment="Center"
                                            Width="130"
                                            Minimum="1"
                                            Maximum="10"
                                            AllowDecimals="False"
                                            TextBlock.TextAlignment="Right"
                                            DataContext="{Binding CurrentApiArgs}"
                                            Value="{Binding MaxHops, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            HorizontalContentAlignment="Right"
                                            Style="{DynamicResource ApiSystemTextBox}" />
                <Slider Minimum="1"
                        Maximum="10"
                        SmallChange="1"
                        TickFrequency="1"
                        LargeChange="1"
                        Width="320"
                        Margin="10 0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        DataContext="{Binding CurrentApiArgs}"
                        Value="{Binding MaxHops, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Text="Max Market Age (Days)"
                       Grid.Row="9"
                       Margin="0 2"
                       HorizontalAlignment="Left"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <slilders:ExponetialSliderWithTextBox Grid.Row="10"
                                                  Margin="0 5"
                                                  TextBoxWidth="130"
                                                  Minimum="1"
                                                  MidPoint="30"
                                                  Maximum="1095"
                                                  DataContext="{Binding CurrentApiArgs}"
                                                  Value="{Binding MaxPriceAge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SliderWidth="320" />

            <!--#endregion-->

            <!--#region Coloumn 3-->
            <Button  Content="Current System"
                     Grid.Column="3"
                     Grid.Row="1"
                     Height="30"
                     Width="200"
                     HorizontalAlignment="Left"
                     Command="{Binding SetCurrentSystemCommand}"
                     Style="{DynamicResource EliteStyleButton}" />

            <Button  Content="Get Stations"
                     Grid.Column="3"
                     Grid.Row="3"
                     Height="30"
                     Width="200"
                     HorizontalAlignment="Left"
                     Command="{Binding GetTradeStationsCommand}"
                     Style="{DynamicResource EliteStyleButton}" />

            <WrapPanel  Grid.Row="4"
                        Grid.RowSpan="8"
                        Grid.Column="2"
                        Margin="5"
                        HorizontalAlignment="Left"
                        FlowDirection="LeftToRight"
                        Width="220">

                <CheckBox IsChecked="{Binding RequiresLargePad}"
                          DataContext="{Binding CurrentApiArgs}"
                          Style="{DynamicResource EliteStyleCheckBox}"
                          Content="Requires Large Pad"
                          Margin="5"
                          Width="210"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" />

                <CheckBox IsChecked="{Binding AllowPlanetary}"
                          DataContext="{Binding CurrentApiArgs}"
                          Style="{DynamicResource EliteStyleCheckBox}"
                          Content="Allow Planetary"
                          Margin="5"
                          Width="210"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" />

                <CheckBox IsChecked="{Binding AllowPlayerOwned}"
                          DataContext="{Binding CurrentApiArgs}"
                          Style="{DynamicResource EliteStyleCheckBox}"
                          Content="Allow Player Owned"
                          Margin="5"
                          Width="210"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" />

                <CheckBox IsChecked="{Binding AllowProhibited}"
                          DataContext="{Binding CurrentApiArgs}"
                          Style="{DynamicResource EliteStyleCheckBox}"
                          Content="Allow Prohibited"
                          Margin="5"
                          Width="210"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" />

                <CheckBox IsChecked="{Binding AllowRestrictedAccess}"
                          DataContext="{Binding CurrentApiArgs}"
                          Style="{DynamicResource EliteStyleCheckBox}"
                          Content="Allow Restricted Access"
                          Width="210"
                          Margin="5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" />

                <CheckBox IsChecked="{Binding Permit}"
                          DataContext="{Binding CurrentApiArgs}"
                          Style="{DynamicResource EliteStyleCheckBox}"
                          Content="Allow Permit Systems"
                          Width="210"
                          Margin="5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" />

                <CheckBox IsChecked="{Binding Unique}"
                          DataContext="{Binding CurrentApiArgs}"
                          Style="{DynamicResource EliteStyleCheckBox}"
                          Content="Avoid Loops"
                          Width="210"
                          Margin="5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" />
            </WrapPanel>
            <!--#endregion-->
        </Grid>
    </DataTemplate>
</ResourceDictionary>