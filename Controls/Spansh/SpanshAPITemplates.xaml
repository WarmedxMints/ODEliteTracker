<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    x:Class="ODEliteTracker.Controls.Spansh.SpanshAPITemplates"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:buttons="clr-namespace:ODEliteTracker.Controls.Buttons"
                    xmlns:textbox="clr-namespace:ODEliteTracker.Controls.TextBox"
                    xmlns:sliders="clr-namespace:ODEliteTracker.Controls.Sliders"
                    xmlns:modelview="clr-namespace:ODEliteTracker.ViewModels.ModelViews.Spansh"
                    xmlns:api="clr-namespace:ODEliteTracker.ViewModels.ModelViews.Spansh.Api"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:spansh="clr-namespace:ODEliteTracker.Models.Spansh"
                    xmlns:wpfconverters="clr-namespace:ODEliteTracker.WPFConverters"
                    xmlns:odmvvm="clr-namespace:ODMVVM.Helpers;assembly=ODMVVM"
                    xmlns:slilders="clr-namespace:ODEliteTracker.Controls.Slilders">

    <ObjectDataProvider x:Key="SpanshRoutingAlgorithmEnum"
                        MethodName="GetValues"
                        ObjectType="{x:Type system:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="spansh:SpanshRoutingAlgorithm" />
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>

    <DataTemplate x:Key="APINotImplement">
        <TextBlock Text="Coming Soon™"
                   Foreground="{DynamicResource Header}"
                   FontSize="24"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <GridLength x:Key="RightColumn">230</GridLength>

    <DataTemplate x:Key="RoadToRichesAPIControl">
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=DataContext}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="{StaticResource RightColumn}" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!--#region Coloumn 1-->
            <TextBlock Text="Source System"
                       Grid.Row="0"
                       Margin="0 2"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <TextBox Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource ApiSystemNameTextBox}"
                     DataContext="{Binding CurrentApiArgs.SourceSystem}"
                     Margin="10"
                     Grid.Row="1"
                     Height="30" />

            <TextBlock Text="Destination System (optional)"
                       Grid.Row="2"
                       Margin="0 2"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />
            <Grid  Grid.Row="3"
                   DataContext="{Binding CurrentApiArgs.TargetSystem}">
                <TextBox Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}"
                         Grid.Row="3"
                         Margin="10"
                         Height="30"
                         Style="{DynamicResource ApiSystemNameTextBox}" />
            </Grid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Range (LY)"
                           Grid.Row="0"
                           Margin="0 2"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Header}"
                           FontSize="14" />

                <textbox:NumberInputTextBox Grid.Row="1"
                                            Margin="10"
                                            Height="30"
                                            HorizontalAlignment="Center"
                                            Width="100"
                                            TextBlock.TextAlignment="Right"
                                            DataContext="{Binding CurrentApiArgs}"
                                            Value="{Binding Range, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            HorizontalContentAlignment="Right"
                                            Style="{DynamicResource ApiSystemTextBox}" />

                <TextBlock Text="Radius (LY)"
                           Grid.Row="0"
                           Grid.Column="1"
                           Margin="0 2"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Header}"
                           FontSize="14" />

                <textbox:NumberInputTextBox Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="10"
                                            Height="30"
                                            HorizontalAlignment="Center"
                                            Width="100"
                                            TextBlock.TextAlignment="Right"
                                            AllowDecimals="False"
                                            DataContext="{Binding CurrentApiArgs}"
                                            Value="{Binding Radius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            HorizontalContentAlignment="Right"
                                            Style="{DynamicResource ApiSystemTextBox}" />

                <TextBlock Text="Maximum Systems"
                           Grid.Row="0"
                           Grid.Column="2"
                           Margin="0 2"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Header}"
                           FontSize="14" />

                <textbox:NumberInputTextBox Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="10"
                                            Height="30"
                                            HorizontalAlignment="Center"
                                            Width="100"
                                            AllowDecimals="False"
                                            TextBlock.TextAlignment="Right"
                                            DataContext="{Binding CurrentApiArgs}"
                                            Value="{Binding MaxResults, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            HorizontalContentAlignment="Right"
                                            Style="{DynamicResource ApiSystemTextBox}" />
            </Grid>

            <DockPanel Grid.Row="5">
                <CheckBox IsChecked="{Binding UseMappingValue}"
                          DataContext="{Binding CurrentApiArgs}"
                          Style="{DynamicResource EliteStyleCheckBox}"
                          Content="Use Mapping Value"
                          Margin="10"
                          FontSize="16"
                          Foreground="{DynamicResource Header}"
                          Grid.Row="5" />

                <CheckBox IsChecked="{Binding AvoidThargoids}"
                          DataContext="{Binding CurrentApiArgs}"
                          Style="{DynamicResource EliteStyleCheckBox}"
                          Content="Avoid Thargoids"
                          Margin="10"
                          FontSize="16"
                          Foreground="{DynamicResource Header}"
                          Grid.Row="6" />
            </DockPanel>


            <CheckBox IsChecked="{Binding Loop}"
                      DataContext="{Binding CurrentApiArgs}"
                      Style="{DynamicResource EliteStyleCheckBox}"
                      Content="Loop"
                      Margin="10"
                      FontSize="16"
                      Foreground="{DynamicResource Header}"
                      Grid.Row="6" />

            <TextBlock Text="Maximum Distance To Arrival"
                       Grid.Row="7"
                       Margin="0 2"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />
            <slilders:ExponetialSliderWithTextBox Grid.Row="8"
                                                  TextBoxWidth="130"
                                                  Minimum="1"
                                                  Margin="0 5"
                                                  MidPoint="100000"
                                                  Maximum="1000000"
                                                  DataContext="{Binding CurrentApiArgs}"
                                                  Value="{Binding MaxDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SliderWidth="320" />

            <TextBlock Text="Minimum Scan Value"
                       Grid.Row="9"
                       Margin="0 2"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />
            <slilders:ExponetialSliderWithTextBox Grid.Row="10"
                                                  TextBoxWidth="130"
                                                  Margin="0 5"
                                                  Minimum="1000"
                                                  MidPoint="500000"
                                                  Maximum="5000000"
                                                  DataContext="{Binding CurrentApiArgs}"
                                                  Value="{Binding MinValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SliderWidth="320" />            
            
            <!--#endregion-->

            <!--#region Coloumn 3-->
            <Button Content="Current System"
                    Grid.Column="3"
                    Grid.Row="1"
                    Height="30"
                    Width="200"
                    HorizontalAlignment="Left"
                    Command="{Binding SetCurrentSystemCommand}"
                    Style="{DynamicResource EliteStyleButton}" />

            <Button Content="Last Game Route System"
                    Grid.Column="3"
                    Grid.Row="3"
                    Height="30"
                    Width="200"
                    HorizontalAlignment="Left"
                    Command="{Binding SetLastGameSystemAsTargetCommand}"
                    Style="{DynamicResource EliteStyleButton}" />

            <!--#endregion-->
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="NeutronRouteAPIControl">
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=DataContext}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="{StaticResource RightColumn}" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!--#region Coloumn 1-->
            <TextBlock Text="Source System"
                       Grid.Row="0"
                       Margin="0 2"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <TextBox Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}"
                     DataContext="{Binding CurrentApiArgs.SourceSystem}"
                     Style="{DynamicResource ApiSystemNameTextBox}"
                     Grid.Row="1"
                     Margin="10"
                     Height="30" />

            <TextBlock Text="Target System"
                       Grid.Row="2"
                       Margin="0 2"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <TextBox Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}"
                     DataContext="{Binding CurrentApiArgs.TargetSystem}"
                     Grid.Row="3"
                     Margin="10"
                     Height="30"
                     Style="{DynamicResource ApiSystemNameTextBox}" />

            <TextBlock Text="Via"
                       Grid.Row="4"
                       Margin="0 2"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <TextBox Grid.Row="5"
                     x:Name="ViaSystemToAdd"
                     Loaded="TextBoxLoaded"
                     Unloaded="TextBoxUnloaded"
                     Margin="10"
                     Height="30"
                     Style="{DynamicResource ApiSystemNameTextBox}" />

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Range (LY)"
                           Grid.Row="0"
                           Margin="0 2"
                           Foreground="{DynamicResource Header}"
                           FontSize="14" />

                <textbox:NumberInputTextBox Grid.Row="1"
                                            Margin="10"
                                            Height="30"
                                            HorizontalAlignment="Left"
                                            Width="100"
                                            TextBlock.TextAlignment="Right"
                                            DataContext="{Binding CurrentApiArgs}"
                                            Value="{Binding Range, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            HorizontalContentAlignment="Right"
                                            Style="{DynamicResource EliteTextBox}" />

                <TextBlock Text="Supercharge"
                           Grid.Row="0"
                           Grid.Column="1"
                           Margin="0 2"
                           Foreground="{DynamicResource Header}"
                           FontSize="14" />

                <buttons:SwitchToggleButton HorizontalAlignment="Left"
                                            Margin="15 0"
                                            VerticalAlignment="Center"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            OffText="Normal"
                                            DataContext="{Binding CurrentApiArgs}"
                                            IsChecked="{Binding OverChargedSuperCharge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            OnText="Overcharge" />
            </Grid>
            <TextBlock Text="Efficiency (%)"
                       Grid.Row="7"
                       Margin="0 2"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <sliders:SliderWithValue Grid.Row="8"
                                     Minimum="1"
                                     Maximum="100"
                                     VerticalAlignment="Center"
                                     DataContext="{Binding CurrentApiArgs}"
                                     Value="{Binding Efficiency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <!--#endregion-->

            <!--#region Coloumn 3-->
            <Button Content="Current System"
                    Grid.Column="3"
                    Grid.Row="1"
                    Height="30"
                    Width="200"
                    HorizontalAlignment="Left"
                    Command="{Binding SetCurrentSystemCommand}"
                    Style="{DynamicResource EliteStyleButton}" />

            <Button Content="Last Game Route System"
                    Grid.Column="3"
                    Grid.Row="3"
                    Height="30"
                    Width="200"
                    HorizontalAlignment="Left"
                    Command="{Binding SetLastGameSystemAsTargetCommand}"
                    Style="{DynamicResource EliteStyleButton}" />

            <Button Content="Add Via"
                    Grid.Column="3"
                    Grid.Row="5"
                    Height="30"
                    Width="200"
                    HorizontalAlignment="Left"
                    Command="{Binding AddAdditionalSystemCommand}"
                    CommandParameter="{Binding ElementName=ViaSystemToAdd, Path=Text}"
                    Style="{DynamicResource EliteStyleButton}" />


            <TextBlock Text="Via Systems"
                       Grid.Row="6"
                       Grid.Column="3"
                       VerticalAlignment="Top"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <DataGrid Grid.Column="3"
                      Grid.Row="6"
                      Grid.RowSpan="8"
                      Margin="0 25 0 0"
                      Height="170"
                      Background="Transparent"
                      VerticalAlignment="Top"
                      Style="{DynamicResource SpanshDataGrid}"
                      RowHeight="25"
                      MaxWidth="230"
                      HeadersVisibility="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      RowStyle="{DynamicResource SpanshApiRowStyle}"
                      FontSize="16"
                      BorderBrush="{DynamicResource PrimaryControlBorder}"
                      BorderThickness="1"
                      PreviewMouseDown="DataGridMouseDown"
                      ItemsSource="{Binding CurrentApiArgs.AdditionalSystems}"
                      SelectedItem="{Binding CurrentApiArgs.SelectedAdditional}">
                <DataGrid.Resources>
                    <odmvvm:WpfBindingProxy x:Key="proxy"
                                            Data="{Binding }" />
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding SystemName}"
                                        Width="*"
                                        CellStyle="{DynamicResource CmdrSelectionCellLeftVertCenter}" />
                    <DataGridTemplateColumn CellStyle="{DynamicResource ButtonGridCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X"
                                        Margin="2"
                                        Command="{Binding Data.DeleteAdditionalSystemCommand, Source={StaticResource proxy}}"
                                        CommandParameter="{Binding }"
                                        Style="{DynamicResource EliteStyleButton}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <!--#endregion-->
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ColonisationRouteAPIControl">
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=DataContext}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="{StaticResource RightColumn}" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--#region Coloumn 1-->
            <TextBlock Text="Source System"
                       Grid.Row="0"
                       Margin="0 2"
                       Foreground="{DynamicResource Header}"
                       FontSize="14" />

            <TextBox Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}"
                     DataContext="{Binding CurrentApiArgs.SourceSystem}"
