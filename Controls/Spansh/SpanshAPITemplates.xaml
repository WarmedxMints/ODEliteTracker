                </Grid.RowDefinitions>
                <TextBlock Text="Cargo"
                           Grid.Row="0"
                           Margin="0 2"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Header}"
                           FontSize="14" />

                <textbox:NumberInputTextBox Grid.Row="1"
                                            Margin="10"
                                            Height="30"
                                            HorizontalAlignment="Center"
                                            Width="100"
                                            AllowDecimals="False"
                                            TextBlock.TextAlignment="Right"
                                            DataContext="{Binding CurrentApiArgs}"
                                            Value="{Binding Cargo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
