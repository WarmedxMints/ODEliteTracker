<UserControl x:Class="ODEliteTracker.Controls.Spansh.SpanshCSVDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ODEliteTracker.Controls.Spansh"
             xmlns:viewmodels="clr-namespace:ODEliteTracker.ViewModels"
             xmlns:models="clr-namespace:ODEliteTracker.Models.Spansh"
             xmlns:converter="clr-namespace:ODEliteTracker.WPFConverters"
             d:DataContext="{d:DesignInstance Type={x:Type viewmodels:SpanshViewModel}}"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <converter:SpanshCSVTypeToVisibility x:Key="VisConverter" />
    </UserControl.Resources>
    <Grid DataContext="{Binding RouteController}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="5" />
            <ColumnDefinition  />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--#region Common Controls-->
        <Grid Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition  Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition  Height="Auto" />
                <RowDefinition  Height="Auto" />
                <RowDefinition  Height="Auto" />
                <RowDefinition  Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Current System"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal"
                        Margin="30 10 0 10"
                        Grid.Row="1">
                <Button Margin="5,0"
                        Height="25"
                        Width="25"
                        Visibility="{Binding ElementName=Root, Path=ButtonsVisibility}"
                        Style="{DynamicResource EliteStyleButton}"
                        Command="{Binding CopyToClipboardCommand}"
                        CommandParameter="{Binding CurrentTarget}"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE77F;" />
                <TextBlock VerticalAlignment="Center"
                           Grid.Row="1"
                           Text="{Binding CurrentTarget.SystemName}" />
            </StackPanel>
            
            <TextBlock Text="Next System"
                       Grid.Row="2"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        Margin="30 10 0 10"
                        Grid.Row="3">
                <Button Margin="5,0"
                        Height="25"
                        Width="25"
                        Grid.Row="2"
                        Visibility="{Binding ElementName=Root, Path=ButtonsVisibility}"
                        Style="{DynamicResource EliteStyleButton}"
                        Command="{Binding CopyToClipboardCommand}"
                        CommandParameter="{Binding NextTarget}"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE77F;" />

                <TextBlock VerticalAlignment="Center"
                           Grid.Column="2"
                           Grid.Row="3"
                           Text="{Binding NextTarget.SystemName}" />
            </StackPanel>

            <TextBlock Text="Remaining Systems"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Grid.Row="4" />
            <TextBlock Text="{Binding RemainingCount, StringFormat=N0}"
                       Grid.Row="5"
                       Margin="63 10 0 10"
                       VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Margin="10"
                        Visibility="{Binding ElementName=Root, Path=ButtonsVisibility}"
                        Grid.ColumnSpan="2"
                        Grid.Row="6">
                <Button Content="Previous"
                        Style="{DynamicResource EliteStyleButton}"
                        Command="{Binding PreviousTargetCommand}"
                        Width="80"
                        Height="30" />
                <Button Content="Next"
                        Margin="20,0,0,0"
                        Style="{DynamicResource EliteStyleButton}"
                        Command="{Binding NextTargetCommand}"
                        Width="80"
                        Height="30" />
            </StackPanel>
        </Grid>

        <Button Content="Delete Route"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Style="{DynamicResource EliteStyleButton}"
                Command="{Binding DeleteRouteCommand}"
                CommandParameter="{Binding CurrentContainer}"
                Visibility="{Binding ElementName=Root, Path=ButtonsVisibility}"
                Width="120"
                Grid.Row="3"
                Margin="10"
                Grid.Column="3"
                Grid.ColumnSpan="3"
                Height="30" />
        <!--#endregion-->

        <!--#region R2R-->
        <Grid Grid.Column="2"
              Visibility="{Binding CurrentType, Converter={StaticResource VisConverter}, ConverterParameter={x:Static models:SpanshRouteType.RoadToRiches}}">
            <DataGrid Style="{Binding ElementName=Root, Path=DataGridStyle}"
                      RowHeight="25"
                      ItemsSource="{Binding CurrentTarget.BodiesInfo}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Body"
                                        MinWidth="100"
                                        Width="*"
                                        CellStyle="{DynamicResource CmdrSelectionCellLeftVertCenter}"
                                        Binding="{Binding Path=Body}" />
                    <DataGridTextColumn MinWidth="100"
                                        Header="Distance"
                                        CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                        Binding="{Binding Path=Distance}" />
                    <DataGridTextColumn MinWidth="60"
                                        CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                        Binding="{Binding Path=Property1}"
                                        Header="Value" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <!--#endregion-->

        <!--#region Neutron Route Info-->
        <Grid Grid.Column="2"
              MinWidth="300"
              Visibility="{Binding CurrentType, Converter={StaticResource VisConverter}, ConverterParameter={x:Static models:SpanshRouteType.NeutronRoute}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="0">
                <TextBlock Text="Jump Distance"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding NextTarget.Property1, StringFormat={}{0} ly}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="1">
                <TextBlock Text="Remaing Distance"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding CurrentTarget.Property2, StringFormat={}{0} ly}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="2">
                <TextBlock Text="Jumps To System"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding NextTarget.Property3}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="3">
                <TextBlock Text="Neutron Star"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding CurrentTarget.Property4}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <!--#endregion-->

        <!--#region World Type-->
        <Grid Grid.Column="2"
              Visibility="{Binding CurrentType, Converter={StaticResource VisConverter}, ConverterParameter={x:Static models:SpanshRouteType.WorldTypeRoute}}">
            <DataGrid Style="{Binding ElementName=Root, Path=DataGridStyle}"
                      Margin="0 5 5 10"
                      RowHeight="25"
                      ItemsSource="{Binding CurrentTarget.BodiesInfo}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Body"
                                        MinWidth="100"
                                        Width="*"
                                        CellStyle="{DynamicResource CmdrSelectionCellLeftVertCenter}"
                                        Binding="{Binding Path=Body}" />
                    <DataGridTextColumn MinWidth="100"
                                        Header="Distance"
                                        CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                        Binding="{Binding Path=Distance, StringFormat={}{0} ls}" />
                    <DataGridTextColumn MinWidth="60"
                                        CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                        Binding="{Binding Path=Property1}"
                                        Header="Jumps" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <!--#endregion-->

        <!--#region Tourist Type-->
        <Grid Grid.Column="2"
              MinWidth="300"
              Visibility="{Binding CurrentType, Converter={StaticResource VisConverter}, ConverterParameter={x:Static models:SpanshRouteType.TouristRoute}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel   Orientation="Horizontal">
                <TextBlock Text="Jump To System"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding NextTarget.Property1}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <!--#endregion-->

        <!--#region Fleet Carrier-->
        <Grid Grid.Column="2"
              MinWidth="300"
              Visibility="{Binding CurrentType, Converter={StaticResource VisConverter}, ConverterParameter={x:Static models:SpanshRouteType.FleetCarrier}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"
                        Grid.Column="1"
                        Grid.Row="0">
                <TextBlock Text="Jump Distance"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock HorizontalAlignment="Left"
                           Text="{Binding NextTarget.Property1, StringFormat={}{0} ly}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="1">
                <TextBlock Text="Remaing Distance"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding CurrentTarget.Property2, StringFormat={}{0} ly}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="2">
                <TextBlock Text="Icy Ring"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="{Binding CurrentTarget.Property3}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="3">
                <TextBlock Text="Est Time Remaining"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="{Binding TimeRemaining}" />
            </StackPanel>
        </Grid>
        <!--#endregion-->

        <!--#region Galaxy Plotter-->
        <Grid Grid.Column="2"
              MinWidth="300"
              Visibility="{Binding CurrentType, Converter={StaticResource VisConverter}, ConverterParameter={x:Static models:SpanshRouteType.GalaxyPlotter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"
                        Grid.Row="0">
                <TextBlock Text="Jump Distance"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding NextTarget.Property1, StringFormat={}{0} ly}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="1">
                <TextBlock Text="Remaing Distance"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding CurrentTarget.Property2, StringFormat={}{0} ly}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="2">
                <TextBlock Text="Refuel"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding CurrentTarget.Property3}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="3">
                <TextBlock Text="Neutron Star"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding CurrentTarget.Property4}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <!--#endregion-->

        <!--#region Exobiology-->
        <Grid Grid.Column="2"
              Visibility="{Binding CurrentType, Converter={StaticResource VisConverter}, ConverterParameter={x:Static models:SpanshRouteType.Exobiology}}">
            <DataGrid Style="{Binding ElementName=Root, Path=DataGridStyle}"
                      HorizontalScrollBarVisibility="Auto"
                      RowHeight="25"
                      ItemsSource="{Binding CurrentTarget.BodiesInfo}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Body"
                                        MinWidth="150"                                     
                                        CellStyle="{DynamicResource CmdrSelectionCellLeftVertCenter}"
                                        Binding="{Binding Path=Body}" />
                    <DataGridTextColumn MinWidth="250"
                                        Width="*"
                                        Header="Species"
                                        CellStyle="{DynamicResource CmdrSelectionCellLeftVertCenter}"
                                        Binding="{Binding Path=Distance}" />
                    <DataGridTextColumn MinWidth="60"
                                        CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                        Binding="{Binding Path=Property1}"
                                        Header="Value" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <!--#endregion-->

        <!--#region Colonisation Plotter-->
        <Grid Grid.Column="2"
              MinWidth="300"
              Visibility="{Binding CurrentType, Converter={StaticResource VisConverter}, ConverterParameter={x:Static models:SpanshRouteType.Colonisation}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"
                        Grid.Row="0">
                <TextBlock Text="Distance"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding CurrentTarget.Property1, StringFormat={}{0} ly}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="1">
                <TextBlock Text="Remaing Distance"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding CurrentTarget.Property2, StringFormat={}{0} ly}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>
