<UserControl x:Class="ODEliteTracker.Controls.Spansh.SpanshCSVDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ODEliteTracker.Controls.Spansh"
             xmlns:viewmodels="clr-namespace:ODEliteTracker.ViewModels"
             xmlns:models="clr-namespace:ODEliteTracker.Models.Spansh"
             xmlns:converter="clr-namespace:ODEliteTracker.WPFConverters"
             d:DataContext="{d:DesignInstance Type={x:Type viewmodels:SpanshViewModel}}"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid DataContext="{Binding RouteController}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--#region Common Controls-->
        <Grid Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition  Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition  Height="Auto" />
                <RowDefinition  Height="Auto" />
                <RowDefinition  Height="Auto" />
                <RowDefinition  Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Current System"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal"
                        Margin="30 10 0 10"
                        Grid.Row="1">
                <Button Margin="5,0"
                        Height="25"
                        Width="25"
                        Visibility="{Binding ElementName=Root, Path=ButtonsVisibility}"
                        Style="{DynamicResource EliteStyleButton}"
                        Command="{Binding CopyToClipboardCommand}"
                        CommandParameter="{Binding CurrentTarget.SystemName}"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE77F;" />
                <TextBlock VerticalAlignment="Center"
                           Grid.Row="1"
                           Text="{Binding CurrentTarget.SystemName}" />
            </StackPanel>

            <TextBlock Text="Next System"
                       Grid.Row="2"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        Margin="30 10 0 10"
                        Grid.Row="3">
                <Button Margin="5,0"
                        Height="25"
                        Width="25"
                        Grid.Row="2"
                        Visibility="{Binding ElementName=Root, Path=ButtonsVisibility}"
                        Style="{DynamicResource EliteStyleButton}"
                        Command="{Binding CopyToClipboardCommand}"
                        CommandParameter="{Binding NextTarget.SystemName}"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE77F;" />

                <TextBlock VerticalAlignment="Center"
                           Grid.Column="2"
                           Grid.Row="3"
                           Text="{Binding NextTarget.SystemName}" />
            </StackPanel>

            <TextBlock Text="Remaining Systems"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Grid.Row="4" />
            <TextBlock Text="{Binding RemainingCount, StringFormat=N0}"
                       Grid.Row="5"
                       Margin="63 10 0 10"
                       VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Margin="10"
                        Visibility="{Binding ElementName=Root, Path=ButtonsVisibility}"
                        Grid.ColumnSpan="2"
                        Grid.Row="6">
                <Button Content="Previous"
                        Style="{DynamicResource EliteStyleButton}"
                        Command="{Binding PreviousTargetCommand}"
                        Width="80"
                        Height="30" />
                <Button Content="Next"
                        Margin="20,0,0,0"
                        Style="{DynamicResource EliteStyleButton}"
                        Command="{Binding NextTargetCommand}"
                        Width="80"
                        Height="30" />
            </StackPanel>
        </Grid>

        <Button Content="Delete Route"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Style="{DynamicResource EliteStyleButton}"
                Command="{Binding DeleteRouteCommand}"
                CommandParameter="{Binding CurrentContainer}"
                Visibility="{Binding ElementName=Root, Path=ButtonsVisibility}"
                Width="120"
                Grid.Row="3"
                Margin="10"
                Grid.Column="3"
                Grid.ColumnSpan="3"
                Height="30" />
        <!--#endregion-->

        <ContentControl Grid.Column="2"
                        MinWidth="300"
                        Margin="0 0 10 0">
            <ContentControl.Style>
                <Style TargetType="{x:Type ContentControl}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentType}"
                                     Value="{x:Static models:SpanshRouteType.RoadToRiches}">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource RoadToRichesDetails}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentType}"
                                     Value="{x:Static models:SpanshRouteType.NeutronRoute}">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource NetronRouteDetails}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentType}"
                                     Value="{x:Static models:SpanshRouteType.Colonisation}">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource ColonisationPlotterRouteDetails}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentType}"
                                     Value="{x:Static models:SpanshRouteType.FleetCarrier}">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource FleetCarrierRouteDetails}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentType}"
                                     Value="{x:Static models:SpanshRouteType.GalaxyPlotter}">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource GalaxyPlotterRouteDetails}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentType}"
                                     Value="{x:Static models:SpanshRouteType.WorldTypeRoute}">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource WorldTypeRouteDetails}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentType}"
                                     Value="{x:Static models:SpanshRouteType.Exobiology}">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource ExobiologyRouteDetails}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentType}"
                                     Value="{x:Static models:SpanshRouteType.TouristRoute}">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource TouristRouteDetails}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentType}"
                                     Value="{x:Static models:SpanshRouteType.TradePlanner}">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource TradePlannerRouteDetails}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>        
    </Grid>
</UserControl>
