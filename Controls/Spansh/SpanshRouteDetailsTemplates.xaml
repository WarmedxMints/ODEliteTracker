                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel   Orientation="Horizontal">
                <TextBlock Text="Jump To System"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding NextTarget.Property1}"
                           VerticalAlignment="Center" />
            </StackPanel>
