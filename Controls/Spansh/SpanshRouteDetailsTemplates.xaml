<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="RoadToRichesDetails">
        <DataGrid Style="{Binding ElementName=Root, Path=DataGridStyle}"
                  RowHeight="25"
                  DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=DataContext}"
                  ItemsSource="{Binding CurrentTarget.BodiesInfo}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Body"
                                    MinWidth="100"
                                    Width="*"
                                    CellStyle="{DynamicResource CmdrSelectionCellLeftVertCenter}"
                                    Binding="{Binding Body}" />
                <DataGridTextColumn MinWidth="100"
                                    Header="Distance"
                                    CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                    Binding="{Binding Distance}" />
                <DataGridTextColumn MinWidth="60"
                                    CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                    Binding="{Binding Property1}"
                                    Header="Value" />
            </DataGrid.Columns>
        </DataGrid>
    </DataTemplate>

    <DataTemplate x:Key="NetronRouteDetails">
        <Grid  DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=DataContext}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="0">
                <TextBlock Text="Jump Distance"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding NextTarget.Property1, StringFormat={}{0} ly}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="1">
                <TextBlock Text="Remaing Distance"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding CurrentTarget.Property2, StringFormat={}{0} ly}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="2">
                <TextBlock Text="Jumps To System"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding NextTarget.Property3}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="3">
                <TextBlock Text="Neutron Star"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding CurrentTarget.Property4}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WorldTypeRouteDetails">
        <DataGrid Style="{Binding ElementName=Root, Path=DataGridStyle}"
                  Margin="0 5 5 10"
                  RowHeight="25"
                  DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=DataContext}"
                  ItemsSource="{Binding CurrentTarget.BodiesInfo}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Body"
                                    MinWidth="100"
                                    Width="*"
                                    CellStyle="{DynamicResource CmdrSelectionCellLeftVertCenter}"
                                    Binding="{Binding Path=Body}" />
                <DataGridTextColumn MinWidth="100"
                                    Header="Distance"
                                    CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                    Binding="{Binding Path=Distance, StringFormat={}{0} ls}" />
                <DataGridTextColumn MinWidth="60"
                                    CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                    Binding="{Binding Path=Property1}"
                                    Header="Jumps" />
            </DataGrid.Columns>
        </DataGrid>
    </DataTemplate>

    <DataTemplate x:Key="TouristRouteDetails">
        <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=DataContext}">
            <Grid.RowDefinitions>
