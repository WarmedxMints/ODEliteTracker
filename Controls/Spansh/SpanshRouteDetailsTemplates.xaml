    <DataTemplate x:Key="ExobiologyRouteDetails">
        <DataGrid Style="{Binding ElementName=Root, Path=DataGridStyle}"
                  HorizontalScrollBarVisibility="Auto"
                  RowHeight="25"
                  DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=DataContext}"
                  ItemsSource="{Binding CurrentTarget.BodiesInfo}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Body"
                                    MinWidth="150"
                                    CellStyle="{DynamicResource CmdrSelectionCellLeftVertCenter}"
                                    Binding="{Binding Path=Body}" />
                <DataGridTextColumn MinWidth="250"
                                    Width="*"
                                    Header="Species"
                                    CellStyle="{DynamicResource CmdrSelectionCellLeftVertCenter}"
                                    Binding="{Binding Path=Distance}" />
                <DataGridTextColumn MinWidth="60"
                                    CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                    Binding="{Binding Path=Property1}"
                                    Header="Value" />
            </DataGrid.Columns>
        </DataGrid>
    </DataTemplate>

    <DataTemplate x:Key="ColonisationPlotterRouteDetails">
        <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=DataContext}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"
                        Grid.Row="0">
                <TextBlock Text="Distance"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding CurrentTarget.Property1, StringFormat={}{0} ly}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="1">
                <TextBlock Text="Remaing Distance"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Width="180" />
                <TextBlock Text="{Binding CurrentTarget.Property2, StringFormat={}{0} ly}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TradePlannerRouteDetails">
        <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=DataContext}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="0">
                <Button Margin="5,0"
                        Height="25"
                        Width="25"
                        Visibility="{Binding ElementName=Root, Path=ButtonsVisibility}"
                        Style="{DynamicResource EliteStyleButton}"
                        Command="{Binding CopyToClipboardCommand}"
                        CommandParameter="{Binding CurrentTarget.TradeResult.SourceSystem}"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE77F;" />
                <TextBlock VerticalAlignment="Center"
                           Grid.Row="1"
                           Text="{Binding CurrentTarget.TradeResult.HeaderText}" />
            </StackPanel>

            <TextBlock Text="Sell The Contents of your hold and purchase"
                       Grid.Row="1"
                       HorizontalAlignment="Left"
                       Margin="10" />
            
            <DataGrid Style="{Binding ElementName=Root, Path=DataGridStyle}"
                      RowHeight="25"
                      Grid.Row="2"
                      Margin="10"
                      DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=DataContext}"
                      ItemsSource="{Binding CurrentTarget.TradeResult.Commodities}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Commodity"
                                        MinWidth="100"
                                        Width="*"
                                        CellStyle="{DynamicResource CmdrSelectionCellLeftVertCenter}"
                                        Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Amount"
                                        MinWidth="70"
                                        CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                        Binding="{Binding Amount}" />
                    <DataGridTextColumn MinWidth="80"
                                        CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                        Binding="{Binding BuyPrice}"
                                        Header="Buy Price" />
                    <DataGridTextColumn MinWidth="80"
                                        CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                        Binding="{Binding SellPrice}"
                                        Header="Sell Price" />
                    <DataGridTextColumn MinWidth="80"
                                        CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                        Binding="{Binding Profit}"
                                        Header="Profit" />
                    <DataGridTextColumn MinWidth="90"
                                        CellStyle="{DynamicResource CmdrSelectionCellRightVertCenter}"
                                        Binding="{Binding TotalProfit}"
                                        Header="Total Profilt" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{Binding CurrentTarget.TradeResult.TotalProfit, StringFormat={}Total Profit {0}}" 
                       Grid.Row="3"
                       HorizontalAlignment="Right"
                       Margin="12 0"/>

            <TextBlock Text="{Binding CurrentTarget.TradeResult.CumulativeProfit, StringFormat={}Cumulative Profit {0}}"
                       Grid.Row="4"
                       HorizontalAlignment="Right"
                       Margin="12 10" />

            <StackPanel Orientation="Horizontal"
                        Grid.Row="6">
                <Button Margin="5,0"
                        Height="25"
                        Width="25"
                        Visibility="{Binding ElementName=Root, Path=ButtonsVisibility}"
                        Style="{DynamicResource EliteStyleButton}"
                        Command="{Binding CopyToClipboardCommand}"
                        CommandParameter="{Binding CurrentTarget.TradeResult.DestinationSystem}"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE77F;" />
                <TextBlock VerticalAlignment="Center"
                           Grid.Row="1"
                           Text="{Binding CurrentTarget.TradeResult.FooterText}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>