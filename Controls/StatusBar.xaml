<UserControl x:Class="ODEliteTracker.Controls.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ODEliteTracker.Controls"
             xmlns:viewmodels="clr-namespace:ODEliteTracker.ViewModels"
             xmlns:models="clr-namespace:ODEliteTracker.Models"
             mc:Ignorable="d"
             FontSize="19"
             Foreground="{DynamicResource PrimaryForeground}"
             d:DataContext="{d:DesignInstance viewmodels:MainViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid Background="{DynamicResource TitleBarBackGround}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition  MinWidth="230"
                               Width="*" />
            <ColumnDefinition  Width="*" />
            <ColumnDefinition  Width="*" />
            <ColumnDefinition  Width="*" />
            <ColumnDefinition  MinWidth="230"
                               Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Content="{Binding CurrentSystemName}"
                Style="{DynamicResource StatusBarBtn}"
                IsEnabled="{Binding UiEnabled, Mode=OneWay}"
                Command="{Binding OpenSystemCommand}"
                Margin="15,0"
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
            <Button.ContextMenu>
                <ContextMenu HasDropShadow="False"
                             TextBlock.FontSize="16"
                             Placement="Top">
                    <MenuItem Header="Open On Inara"
                              Command="{Binding OpenSystemFromEnumCommand}"
                              CommandParameter="{x:Static models:SystemWebSite.Inara}"
                              Style="{DynamicResource EliteContextMenuItemStyle}" />
                    <MenuItem Header="Open On Spansh"
                              Command="{Binding OpenSystemFromEnumCommand}"
                              CommandParameter="{x:Static models:SystemWebSite.Spansh}"
                              Style="{DynamicResource EliteContextMenuItemStyle}" />
                    <MenuItem Header="Open On Raven Colonial"
                              Command="{Binding OpenSystemFromEnumCommand}"
                              CommandParameter="{x:Static models:SystemWebSite.RavenColonial}"
                              Style="{DynamicResource EliteContextMenuItemStyle}" />
                    <MenuItem Header="Copy To Clipboard"
                              Command="{Binding CopyToClipboardCommand}"
                              CommandParameter="{Binding CurrentSystemName}"
                              Style="{DynamicResource EliteContextMenuItemStyle}" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <Button Content="{Binding CurrentBody_Station}"
                Style="{DynamicResource StatusBarBtn}"
                IsEnabled="{Binding UiEnabled, Mode=OneWay}"
                Command="{Binding OpenStationCommand}"
                Margin="5,0"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Button.ContextMenu>
                <ContextMenu HasDropShadow="False"
                             TextBlock.FontSize="16"
                             Placement="Top">
                    <MenuItem Header="Open On Inara"
                              Command="{Binding OpenStationFromEnumCommand}"
                              CommandParameter="{x:Static models:SystemWebSite.Inara}"
                              Style="{DynamicResource EliteContextMenuItemStyle}" />
                    <MenuItem Header="Open On Spansh"
                              Command="{Binding OpenStationFromEnumCommand}"
                              CommandParameter="{x:Static models:SystemWebSite.Spansh}"
                              Style="{DynamicResource EliteContextMenuItemStyle}" />
                    <MenuItem Header="Copy To Clipboard"
                              Command="{Binding CopyToClipboardCommand}"
                              CommandParameter="{Binding CurrentBody_Station}"
                              Style="{DynamicResource EliteContextMenuItemStyle}" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>

        <TextBlock Text="{Binding CurrentRegion}"
                   Foreground="{DynamicResource PrimaryForeground}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Grid.Column="2"
                   Margin="5,0" />
        
        <Button Content="{Binding CurrentShipName}"
                Style="{DynamicResource StatusBarBtn}"
                IsEnabled="{Binding UiEnabled, Mode=OneWay}"
                Command="{Binding OpenShipyardCommand}"
                Margin="5,0"
                Grid.Column="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Button.ContextMenu>
                <ContextMenu HasDropShadow="False"
                             TextBlock.FontSize="16"
                             Placement="Top">
                    <MenuItem Header="Open On EDSY"
                              Command="{Binding OpenShipyardFromEnumCommand}"
                              CommandParameter="{x:Static models:ShipyardWebSite.EDSY}"
                              Style="{DynamicResource EliteContextMenuItemStyle}" />
                    <MenuItem Header="Open On Coriolis"
                              Command="{Binding OpenShipyardFromEnumCommand}"
                              CommandParameter="{x:Static models:ShipyardWebSite.Coriolis}"
                              Style="{DynamicResource EliteContextMenuItemStyle}" />
                    <MenuItem Header="Copy To Clipboard"
                              Command="{Binding CopyToClipboardCommand}"
                              CommandParameter="{Binding CurrentShipName}"
                              Style="{DynamicResource EliteContextMenuItemStyle}" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>

        <StackPanel  Margin="5,5"
                     Grid.Column="4"
                     Orientation="Horizontal"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center">
            <ComboBox ItemsSource="{Binding JournalCommanders}"
                      SelectedValue="{Binding SelectedCommander}"
                      Style="{DynamicResource TopPlacementComboBox}"
                      DisplayMemberPath="Name"
                      MinWidth="230"
                      Tag="Up"
                      FontSize="18"
                      IsEnabled="{Binding UiEnabled, Mode=OneWay}"
                      IsReadOnly="True"
                      IsSynchronizedWithCurrentItem="False" />
            <Button Style="{DynamicResource EliteStyleButton}"
                    Command="{Binding RefreshCommanderCommand}"
                    IsEnabled="{Binding UiEnabled, Mode=OneWay}"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="18"
                    Content="&#xE72C;"
                    Margin="5,0">
                <Button.ToolTip>
                    <TextBlock Text="Reload Commander"
                               FontFamily="{StaticResource Eurostile}" />
                </Button.ToolTip>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
