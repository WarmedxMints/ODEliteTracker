<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:modelview="clr-namespace:ODEliteTracker.ViewModels.ModelViews.Spansh">

    <Style TargetType="{x:Type TextBox}"
           x:Key="PopOutTextBox">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="Background"
                Value="{DynamicResource PrimaryControlBackground}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource PrimaryControlBorder}" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource EliteBtnBGMouseOver}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">                   
                    <Border x:Name="border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="false"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled"
                                 Value="false">
                            <Setter Property="Opacity"
                                    TargetName="border"
                                    Value="0.56" />
                        </Trigger>                                 
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="BorderBrush"
                                    TargetName="border"
                                    Value="{DynamicResource PrimaryControlMouseOver}" />
                        </Trigger>
                        <Trigger Property="IsFocused"
                                 Value="true">
                            <Setter Property="BorderBrush"
                                    TargetName="border"
                                    Value="{DynamicResource PrimaryControlBorder}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding TitleBarVisibility}"
                                     Value="Collapsed">
                            <Setter Property="BorderThickness"
                                    TargetName="border"
                                    Value="0" />
                            <Setter Property="Background"
                                    TargetName="border"
                                    Value="Transparent" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>           
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBox}"
           x:Key="NoSelectTextBox">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="Background"
                Value="{DynamicResource PrimaryControlBackground}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource PrimaryControlBorder}" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource EliteBtnBGMouseOver}" />
        <Setter Property="IsHitTestVisible"
                Value="False" />
        <Setter Property="IsReadOnly"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="false"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled"
                                 Value="false">
                            <Setter Property="Opacity"
                                    TargetName="border"
                                    Value="0.56" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="BorderBrush"
                                    TargetName="border"
                                    Value="{DynamicResource PrimaryControlMouseOver}" />
                        </Trigger>
                        <Trigger Property="IsFocused"
                                 Value="true">
                            <Setter Property="BorderBrush"
                                    TargetName="border"
                                    Value="{DynamicResource PrimaryControlBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="{x:Type TextBox}"
           x:Key="CompassTextBox">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="Background"
                Value="{DynamicResource PrimaryControlBackground}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource PrimaryControlBorder}" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource EliteBtnBGMouseOver}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="false"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled"
                                 Value="false">
                            <Setter Property="Opacity"
                                    TargetName="border"
                                    Value="0.56" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="BorderBrush"
                                    TargetName="border"
                                    Value="{DynamicResource PrimaryControlMouseOver}" />
                        </Trigger>
                        <Trigger Property="IsFocused"
                                 Value="true">
                            <Setter Property="BorderBrush"
                                    TargetName="border"
                                    Value="{DynamicResource PrimaryControlBorder}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding TitleBarVisibility}"
                                     Value="Collapsed">
                            <Setter Property="BorderThickness"
                                    TargetName="border"
                                    Value="0" />
                            <Setter Property="Background"
                                    TargetName="border"
                                    Value="Transparent" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=Root, Path=ValidValue}"
                                     Value="False">
                            <Setter Property="Foreground"
                                    Value="Red" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=Root, Path=ValidValue}"
                                     Value="True">
                            <Setter Property="Foreground"
                                    Value="{Binding ElementName=Root, Path=Foreground}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBlock}"
           x:Key="EliteTextBlock">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryForeground}" />
    </Style>

    <Style TargetType="{x:Type TextBox}"
           x:Key="EliteTextBox">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="Background"
                Value="{DynamicResource PrimaryControlBackground}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource PrimaryControlBorder}" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource EliteBtnBGMouseOver}" />
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryForeground}" />
        <Setter Property="SelectionBrush"
                Value="{DynamicResource EliteBtnBGMouseOver}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="border"
                            Padding="2"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="false"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled"
                                 Value="false">
                            <Setter Property="Opacity"
                                    TargetName="border"
                                    Value="0.56" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="BorderBrush"
                                    TargetName="border"
                                    Value="{DynamicResource PrimaryControlMouseOver}" />
                        </Trigger>
                        <Trigger Property="IsFocused"
                                 Value="true">
                            <Setter Property="BorderBrush"
                                    TargetName="border"
                                    Value="{DynamicResource PrimaryControlBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox"
           x:Key="ApiSystemNameTextBox"
           BasedOn="{StaticResource EliteTextBox}">
        <Setter Property="ContextMenu"
                Value="{StaticResource TextBoxContextMenu}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}"
                         Value="{x:Static modelview:NameCheckStatus.Bad}">
                <Setter Property="Foreground"
                        Value="Red" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox"
           x:Key="ApiSystemTextBox"
           BasedOn="{StaticResource EliteTextBox}">
        <Setter Property="ContextMenu"
                Value="{DynamicResource TextBoxContextMenu}" />
    </Style>

    <Style TargetType="{x:Type TextBlock}"
           x:Key="ApiSystemNameTextBlock"
           BasedOn="{StaticResource EliteTextBlock}">
        <Setter Property="ContextMenu"
                Value="{StaticResource TextBoxContextMenu}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}"
                         Value="{x:Static modelview:NameCheckStatus.Bad}">
                <Setter Property="Foreground"
                        Value="Red" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>