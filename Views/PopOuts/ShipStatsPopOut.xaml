<UserControl x:Class="ODEliteTracker.Views.PopOuts.ShipStatsPopOut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ODEliteTracker.Views.PopOuts"
             xmlns:text="clr-namespace:ODEliteTracker.Controls.Text"
             xmlns:busyIndicator="https://github.com/moh3ngolshani/BusyIndicator"
             xmlns:popouts="clr-namespace:ODEliteTracker.ViewModels.PopOuts"
             d:DataContext="{d:DesignInstance popouts:ShipStatsPopOutVM}"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="700">
    <UserControl.Resources>
        <Style TargetType="{x:Type text:TextWithHeader}">
            <Setter Property="Width"
                    Value="150" />
            <Setter Property="Height"
                    Value="60" />
            <Setter Property="HeaderVerticalAlignment"
                    Value="Center" />
            <Setter Property="HeaderHorizontalAlignment"
                    Value="Left" />
            <Setter Property="HeaderMargin"
                    Value="5 0 0 0" />
            <Setter Property="TextHorizontalAlignment"
                    Value="Center" />
            <Setter Property="HeaderFontColour"
                    Value="{DynamicResource Overlay_ForegroundBrush}" />
            <Setter Property="TextColour"
                    Value="{DynamicResource Overlay_ForegroundBrush}" />
            <Setter Property="HeaderFontSize"
                    Value="16" />
            <Setter Property="Margin"
                    Value="5" />
        </Style>
    </UserControl.Resources>
    <busyIndicator:BusyMask x:Name="BusyIndicator"
                            IsBusy="{Binding IsBusy}"
                            Background="{DynamicResource Overlay_CardBackground}"
                            Foreground="{DynamicResource Overlay_ForegroundBrush}"
                            FontSize="30"
                            BusyContent="Parsing Mining Logs"
                            IndicatorType="Cupertino"
                            BusyContentMargin="0,20,0,0">
        <Border CornerRadius="5"
                Grid.Row="2"
                Padding="5">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource Overlay_CardBackGrounColour}"
                                 Opacity="{Binding Opacity, Mode=OneWay}" />
            </Border.Background>
            <Grid TextBlock.FontSize="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Orientation="Horizontal"
                           Grid.Row="0"
                           Margin="5">
                    <text:TextWithHeader HeaderText="Name"
                                         Text="{Binding CurrentShip.Name}"
                                         Visibility="{Binding ShowName, Converter={StaticResource BoolToVis}}" />
                    <text:TextWithHeader HeaderText="Model"
                                         Text="{Binding CurrentShip.ShipType}"
                                         Visibility="{Binding ShowType, Converter={StaticResource BoolToVis}}" />
                    <text:TextWithHeader HeaderText="Jump Range"
                                         Text="{Binding CurrentShip.JumpRangeString}"
                                         Visibility="{Binding ShowCurrentJumpRange, Converter={StaticResource BoolToVis}}" />
                    <text:TextWithHeader HeaderText="Total Range"
                                         Text="{Binding CurrentShip.TotalRangeText}"
                                         Visibility="{Binding ShowTotalRange, Converter={StaticResource BoolToVis}}" />
                    <text:TextWithHeader HeaderText="Ident"
                                         Text="{Binding CurrentShip.Ident}"
                                         Visibility="{Binding ShowIdent, Converter={StaticResource BoolToVis}}" />

                    <Grid Grid.Column="1"
                          Visibility="{Binding ShowCargo, Converter={StaticResource BoolToVis}}"
                          HorizontalAlignment="Stretch"
                          Width="150"
                          Height="75"
                          Margin="10"
                          Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Cargo"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="|"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Grid.Column="1" />
                        <TextBlock Text="Capacity"
                                   FontSize="16"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentShip.CurrentCargo, StringFormat={}{0:N0}}"
                                   Grid.Row="1"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="|"
                                   Grid.Row="1"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Grid.Column="1" />
                        <TextBlock Text="{Binding CurrentShip.CargoCapacity, StringFormat={}{0:N0}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Grid.Column="2"
                                   FontSize="14"
                                   Grid.Row="1" />
                    </Grid>
                    <text:TextWithHeader HeaderText="Jump Range Laden"
                                         Visibility="{Binding ShowJumpLaden, Converter={StaticResource BoolToVis}}"
                                         Text="{Binding CurrentShip.JumpRangeLaden}" />
                    <Grid Width="150"
                          Height="75"
                          Margin="10"
                          Visibility="{Binding ShowModules, Converter={StaticResource BoolToVis}}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Scoop"
                                   Grid.Column="0"
                                   Grid.Row="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16" />
                        <TextBlock Text="{Binding CurrentShip.HasScoopYesNo}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Grid.Column="0"
                                   Grid.Row="1"
                                   Margin="10" />

                        <TextBlock Text="DSS"
                                   Grid.Column="1"
                                   Grid.Row="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16" />
                        <TextBlock Text="{Binding CurrentShip.HasDSS}"
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="10" />
                        <TextBlock Text="AFMU"
                                   Grid.Column="2"
                                   Grid.Row="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16" />
                        <TextBlock Text="{Binding CurrentShip.HasAFMU}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Grid.Column="2"
                                   Grid.Row="2" />
                    </Grid>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal"
                           Visibility="{Binding TitleBarVisibility}"
                           Grid.Row="2">
                    <CheckBox Style="{DynamicResource EliteStyleCheckBoxPopUp}"
                              IsChecked="{Binding ShowName}"
                              Margin="5"
                              Width="190"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              Content="Name" />
                    <CheckBox Style="{DynamicResource EliteStyleCheckBoxPopUp}"
                              IsChecked="{Binding ShowType}"
                              Margin="5"
                              Width="190"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              Content="Model" />
                    <CheckBox Style="{DynamicResource EliteStyleCheckBoxPopUp}"
                              IsChecked="{Binding ShowCurrentJumpRange}"
                              Margin="5"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              Width="190"
                              Content="Current Jump Range" />
                    <CheckBox Style="{DynamicResource EliteStyleCheckBoxPopUp}"
                              IsChecked="{Binding ShowTotalRange}"
                              Margin="5"
                              Width="190"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              Content="Total Jump Range" />
                    <CheckBox Style="{DynamicResource EliteStyleCheckBoxPopUp}"
                              IsChecked="{Binding ShowIdent}"
                              Margin="5"
                              Width="190"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              Content="Ident" />
                    <CheckBox Style="{DynamicResource EliteStyleCheckBoxPopUp}"
                              IsChecked="{Binding ShowCargo}"
                              Margin="5"
                              Width="190"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              Content="Cargo" />
                    <CheckBox Style="{DynamicResource EliteStyleCheckBoxPopUp}"
                              IsChecked="{Binding ShowJumpLaden}"
                              Margin="5"
                              Width="190"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              Content="Jump Range Laden" />
                    <CheckBox Style="{DynamicResource EliteStyleCheckBoxPopUp}"
                              IsChecked="{Binding ShowModules}"
                              Margin="5"
                              Width="190"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              Content="Modules" />
                </WrapPanel>
            </Grid>
        </Border>
    </busyIndicator:BusyMask>
</UserControl>
