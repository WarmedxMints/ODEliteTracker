<UserControl x:Class="ODEliteTracker.Views.PopOuts.StraightLinePopOut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ODEliteTracker.Views.PopOuts"
             mc:Ignorable="d"
             xmlns:popouts="clr-namespace:ODEliteTracker.ViewModels.PopOuts"
             xmlns:galaxy="clr-namespace:ODEliteTracker.Controls.Galaxy"
             xmlns:busyIndicator="https://github.com/moh3ngolshani/BusyIndicator"
             d:DataContext="{d:DesignInstance popouts:StraightLineToolPopOut}"
             d:DesignHeight="450" d:DesignWidth="800">
    <busyIndicator:BusyMask x:Name="BusyIndicator"
                            IsBusy="{Binding IsBusy}"
                            Background="{DynamicResource Overlay_CardBackground}"
                            Foreground="{DynamicResource Overlay_ForegroundBrush}"
                            FontSize="30"
                            BusyContent="Parsing Colonisation Logs"
                            IndicatorType="Cupertino"
                            BusyContentMargin="0,20,0,0">
        <Border CornerRadius="5"
                Grid.Row="2"
                Padding="5">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource Overlay_CardBackGrounColour}"
                                 Opacity="{Binding Opacity, Mode=OneWay}" />
            </Border.Background>
            <Grid TextBlock.FontSize="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Start Position"
                           Margin="5 10"
                           Visibility="{Binding TitleBarVisibility}"
                           Foreground="{DynamicResource Overlay_ForegroundBrush}"
                           VerticalAlignment="Center" />

                <ToggleButton Name="SetStarPosBtn"
                              Width="80"
                              Height="25"
                              Content="Set"
                              HorizontalAlignment="Right"
                              BorderThickness="0"
                              Visibility="{Binding TitleBarVisibility}"
                              Style="{DynamicResource EliteSytleImageToggleBtn}"
                              Margin="5,0">
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=SetStarPosBtn}"
                       Closed="Popup_Closed"
                       ButtonBase.Click="Popup_Click"
                       Tag="SetStarPos"
                       Placement="Mouse"
                       StaysOpen="False">
                    <Border Background="{DynamicResource ViewBackground}"
                            BorderBrush="{DynamicResource PrimaryControlBorder}"
                            Padding="5"
                            BorderThickness="1">
                        <StackPanel>
                            <Button Content="Use Selected System"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,2"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding Planner.SetStartAsSelectedCommand}"
                                    Style="{DynamicResource PopOutBtn}" />
                            <Button Content="Use Current System"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,2"
                                    HorizontalContentAlignment="Left"
                                    Style="{DynamicResource PopOutBtn}"
                                    Command="{Binding Planner.SetStartAsCurrentCommand}" />
                        </StackPanel>
                    </Border>
                </Popup>

                <galaxy:PositionControl Position="{Binding Planner.StartPos}"
                                        Visibility="{Binding TitleBarVisibility}"
                                        Grid.Row="1" 
                                        InOverlay="True"/>

                <TextBlock Text="End Position"
                           Margin="5 10"
                           Visibility="{Binding TitleBarVisibility}"
                           Foreground="{DynamicResource Overlay_ForegroundBrush}"
                           VerticalAlignment="Center"
                           Grid.Row="2" />

                <ToggleButton Name="SetTargetPosBtn"
                              Width="80"
                              Height="25"
                              Grid.Row="2"
                              Content="Set"
                              HorizontalAlignment="Right"
                              BorderThickness="0"
                              Visibility="{Binding TitleBarVisibility}"
                              Style="{DynamicResource EliteSytleImageToggleBtn}"
                              Margin="5,0">
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=SetTargetPosBtn}"
                       Closed="Popup_Closed"
                       ButtonBase.Click="Popup_Click"
                       Tag="SetTargetPos"
                       Placement="Mouse"
                       StaysOpen="False">
                    <Border Background="{DynamicResource ViewBackground}"
                            BorderBrush="{DynamicResource PrimaryControlBorder}"
                            Padding="5"
                            BorderThickness="1">
                        <StackPanel>
                            <Button Content="Use Target System"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,2"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding Planner.SetEndAsTargetCommand}"
                                    Style="{DynamicResource PopOutBtn}" />
                            <Button Content="Use Selected System"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,2"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding Planner.SetEndAsSelectedCommand}"
                                    Style="{DynamicResource PopOutBtn}" />
                            <Button Content="Use Current System"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,2"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding Planner.SetEndAsCurrentCommand}"
                                    Style="{DynamicResource PopOutBtn}" />
                        </StackPanel>
                    </Border>
                </Popup>

                <galaxy:PositionControl Position="{Binding Planner.EndPos}"
                                        Visibility="{Binding TitleBarVisibility}"
                                        Grid.Row="3"
                                        InOverlay="True" />

                <Grid Grid.Row="5"
                      TextBlock.FontSize="20"
                      Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Current distance from start position"
                               Foreground="{DynamicResource Overlay_ForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0 5"
                               Grid.Row="0" />
                    <TextBlock Text="{Binding Planner.DistanceFromStart}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Grid.Row="1"
                               Margin="0 5"
                               Grid.Column="1" />

                    <TextBlock Text="Current distance from 500ly point "
                               Foreground="{DynamicResource Overlay_ForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0 5"
                               Grid.Row="2" />
                    <TextBlock Text="{Binding Planner.DistanceFrom500ly}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Grid.Row="3"
                               Margin="0 5"
                               Grid.Column="1" />

                    <TextBlock Text="Current distance from straight line"
                               Foreground="{DynamicResource Overlay_ForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0 5"
                               Grid.Row="4" />
                    <TextBlock Text="{Binding Planner.DistanceFromStraightLine}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Grid.Row="5"
                               Margin="0 5"
                               Grid.Column="1" />

                    <TextBlock Text="Directions to closest point on line"
                               Foreground="{DynamicResource Overlay_ForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0 5"
                               Grid.Row="6" />
                    <TextBlock Text="{Binding Planner.DirectionsToStraightLine}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Grid.Row="7"
                               Margin="0 5"
                               Grid.Column="1" />
                </Grid>
            </Grid>
        </Border>
    </busyIndicator:BusyMask>
</UserControl>
